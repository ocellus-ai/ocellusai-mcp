# Copy to .env (not committed) and fill in. Docker Compose reads .env for the
# ${...} in docker-compose.yml, and env_file passes it to the container, where
# ocellusai-mcp fills the ${VAR} in config.yaml from it.

# Image to run; pin a tag (CI pushes <commit sha>, main, latest, vX.Y.Z).
# OCELLUSAI_MCP_IMAGE=quay.io/ocellusai/ocellusai-mcp:latest

# Host address:port the MCP endpoint is published on. It has no authentication:
# use 0.0.0.0:8080 only behind a reverse proxy or firewall.
MCP_PUBLISH=127.0.0.1:8080

# Prometheus (or VictoriaMetrics, Thanos) base URL.
MCP_PROMETHEUS_URL=http://prometheus:9090
# Only when the headers block in config.yaml is uncommented:
# MCP_PROMETHEUS_TOKEN=

# debug | info | warn | error
MCP_LOG_LEVEL=info
